# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

DJANGO_SETTINGS_MODULE=config.settings.dev
# Gere uma chave real com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-me-before-deploying-to-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Aponta para o serviço "db" do docker-compose.yml da raiz do projeto.
DATABASE_URL=postgres://almox_v1:almox_v1@localhost:5432/almox_v1

# Origem do front-end React (Vite) em desenvolvimento.
CORS_ALLOWED_ORIGINS=http://localhost:5173
